{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev && npm --prefix public-web install --include=dev",
  "buildCommand": "node scripts/build-web.js",
  "outputDirectory": "dist-web",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/gennetex/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/employee-auth", "destination": "https://gennetex.vercel.app/api/employee-auth" },
    { "source": "/gennetex/admin", "destination": "/gennetex/admin/index.html" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/win", "destination": "/win/index.html" },
    { "source": "/mac", "destination": "/mac/index.html" },
    { "source": "/about", "destination": "/" },
    { "source": "/services", "destination": "/" },
    { "source": "/projects", "destination": "/" },
    { "source": "/contact", "destination": "/" },
    { "source": "/careers", "destination": "/" }
  ]
}
