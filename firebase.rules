rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'avatar_url', 'latitude', 'longitude', 'last_seen', 'face_uuid',
          'face_enrolled', 'must_change_password', 'report_signature_url',
          'telegram_user_id', 'telegram_username', 'telegram_linked_at'
        ]));
      allow delete: if isAdmin();
    }

    // Server Admin SDK only: PIN hashes and verify.mn session audit must never reach clients.
    match /employeeAuthSecrets/{userId} {
      allow read, write: if false;
    }

    match /verificationSessions/{sessionId} {
      allow read, write: if false;
    }

    // Агуулахын нэр төрөл, багаж болон бусдад олголтыг зөвхөн админ удирдана.
    // Ажилтан зөвхөн өөртөө авах үед агуулахын тоог бууруулж болно.
    match /inventory/{itemId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity'])
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.quantity <= resource.data.quantity);
    }

    match /stock_movements/{movementId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.user_id == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{collection}/{document=**} {
      allow read: if signedIn()
        && !(collection in ['employeeAuthSecrets', 'verificationSessions']);
      allow create, update, delete: if signedIn()
        && !(collection in ['employeeAuthSecrets', 'verificationSessions', 'inventory', 'stock_movements', 'vehicles']);
    }
  }
}
